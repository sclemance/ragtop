#!/bin/bash
# Ragtop's settings, behind its rows in the Omarchy menu (Setup › Tablet).
#
# Usage: ragtop overlay enabled <overlay>   succeeds if touch typing is on
#        ragtop overlay enable <overlay>
#        ragtop overlay disable <overlay>
#        ragtop overlay toggle <overlay>
#        ragtop overlay status
#        ragtop overlay sync              re-clones any that Omarchy or Ragtop moved on from
#        ragtop auto-show (enabled | enable | disable | toggle)
#        ragtop tablet-mode (get | is <mode> | set <mode>)
#        ragtop size-adjust (get | is <adjust> | set <adjust>)
#        ragtop rotation (get | is <mode> | set <mode>)
#        ragtop theme (list | apply <theme>)
#        ragtop setup                       open setup in the shell
#        ragtop diagnostics [copy]          what a bug report needs
# where <overlay> is menu, emojis, clipboard, polkit, image-picker or lock,
# <mode> is auto
# (follow the hardware switch — folding a hinge or taking the keyboard off),
# on or off.
#
# What a key looks like is a Ragtop theme's to say, so shape, relief, fill,
# background, edge and both transparencies have no verb here and no menu
# row. Whether the keyboard has a background at all follows Omarchy's bar,
# which a double tap on it toggles. What is left is <adjust>, one of
# smallest, smaller, regular, larger or largest, which sizes the keys
# against whatever the theme asked for and is never written by applying one.
# Rotation <mode> is locked, unlocked, or auto, which turns the screen while
# the machine is folded and holds it still while it is a laptop.
#
# A theme is a TOML file of those same settings, laid out the way Omarchy
# lays its own themes out: themes/<slug>/ragtop.toml under Ragtop, and
# ~/.config/ragtop/themes/<slug>/ragtop.toml for your own, where yours wins.
# It sets the keyboard's form. Its colours keep coming from the Omarchy theme.
# Applying one writes its values into settings.conf, so afterwards every
# setting shows what is actually in effect and nothing stays hidden in a file.
#
# Touch typing in an overlay means replacing Omarchy's own with a patched
# clone (see overlay-clones.sh), so each one is off until the user turns it on.
# Other settings are key=value lines in settings.conf, which Ragtop's
# service watches, so they apply straight away.
set -euo pipefail

repo="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
conf="$HOME/.local/state/ragtop/install.conf"
clones="$repo/overlay-clones.sh"
settings="$HOME/.config/ragtop/settings.conf"
menu_file="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"

usage() { sed -n '4,30p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

label() {
  case "$1" in
    menu) echo "the Omarchy menu" ;;
    emojis) echo "the emoji picker" ;;
    clipboard) echo "the clipboard picker" ;;
    polkit) echo "the password prompt" ;;
    image-picker) echo "the theme and background pickers" ;;
    lock) echo "the lock screen" ;;
    *) echo "Unknown overlay: $1 (expected: menu, emojis, clipboard, polkit, image-picker, lock)" >&2; exit 2 ;;
  esac
}

# Records which overlays the user turned on, so setup-check.sh can tell a
# clone that went missing from one that was never wanted.
record() {
  local on=() o
  for o in menu emojis clipboard polkit image-picker lock; do
    "$clones" installed "$o" && on+=("$o")
  done
  mkdir -p "$(dirname "$conf")"
  if [[ -f $conf ]] && grep -q '^overlays=' "$conf"; then
    sed -i "s/^overlays=.*/overlays=${on[*]}/" "$conf"
  else
    printf 'overlays=%s\n' "${on[*]}" >>"$conf"
  fi
}

notify() {
  command -v omarchy-notification-send >/dev/null &&
    omarchy-notification-send -g 󰌌 "Ragtop" "$1" || true
}

set_overlay() {
  local overlay="$1" on="$2" name
  name=$(label "$overlay")
  if (( on )); then
    "$clones" install "$overlay" >/dev/null
    record
    if [[ $overlay == lock ]]; then
      notify "The lock screen now has an on-screen keyboard in tablet mode."
    elif [[ $overlay == image-picker ]]; then
      notify "${name^} now have arrows and a Select button in tablet mode."
    else
      notify "Touch typing is on for ${name}."
    fi
  else
    "$clones" remove "$overlay" >/dev/null
    record
    if [[ $overlay == lock ]]; then
      notify "The lock screen no longer has an on-screen keyboard."
    elif [[ $overlay == image-picker ]]; then
      notify "${name^} no longer have arrows and a Select button."
    else
      notify "Touch typing is off for ${name}."
    fi
  fi
  # Omarchy only picks clones up, or drops them, when the shell starts.
  omarchy-restart-shell >/dev/null 2>&1 &
}

# get <key> <default>
get() {
  local value
  value=$(sed -n "s/^$1=//p" "$settings" 2>/dev/null | tail -n 1)
  echo "${value:-$2}"
}

# put <key> <value>, written whole and renamed into place so the service
# never reads a half-written file.
put() {
  mkdir -p "$(dirname "$settings")"
  { grep -v "^$1=" "$settings" 2>/dev/null || true; echo "$1=$2"; } >"$settings.tmp"
  mv -f "$settings.tmp" "$settings"
}

# switch <key> <enabled|enable|disable|toggle> for an on/off setting that
# defaults to on.
switch() {
  local key="$1" value
  case "${2:-}" in
    enabled) [[ $(get "$key" on) == on ]]; return ;;
    enable) value=on ;;
    disable) value=off ;;
    toggle) [[ $(get "$key" on) == on ]] && value=off || value=on ;;
    *) usage ;;
  esac
  put "$key" "$value"
  case "$key $value" in
    "auto-show on") notify "The keyboard now comes up by itself on text fields." ;;
    "auto-show off") notify "The keyboard no longer comes up by itself on text fields." ;;
  esac
}

# choice <key> <default> <get|is|set> [value] for a setting with named values;
# the allowed values are the cases in choice_notice.
choice() {
  local key="$1" default="$2"
  case "${3:-}" in
    get) get "$key" "$default" ;;
    is) [[ -n ${4:-} ]] || usage; [[ $(get "$key" "$default") == "$4" ]] ;;
    set)
      local notice
      notice=$(choice_notice "$key" "${4:-}") || usage
      put "$key" "$4"
      # A setting with nothing to say says nothing. Key size is dragged on a
      # slider with the keyboard resizing under it, so the change announces
      # itself and a notification per step is just noise.
      if [[ -n $notice ]]; then notify "$notice"; fi
      ;;
    *) usage ;;
  esac
}

choice_notice() {
  case "$1 $2" in
    "tablet-mode auto") echo "Tablet mode now follows the hardware: fold the screen back, or take the keyboard off." ;;
    "tablet-mode on") echo "Tablet mode is on until you change it back." ;;
    "tablet-mode off") echo "Tablet mode is off until you change it back." ;;
    "size-adjust smallest"|"size-adjust smaller"|"size-adjust regular"\
      |"size-adjust larger"|"size-adjust largest") echo "" ;;
    "rotation locked") echo "The screen will not rotate." ;;
    "rotation unlocked") echo "The screen follows the sensor." ;;
    "rotation auto") echo "The screen rotates while the machine is folded." ;;
    "labels small"|"labels normal"|"labels large") echo "The key labels are now $2." ;;
    *) return 1 ;;
  esac
}

# migrate: bring a machine set up by an older Ragtop up to date, and say
# nothing when there is nothing to do. It runs at every shell start, so it
# has to be both idempotent and quiet.
#
# 0.39 renamed presets to themes, moved them from a file to a directory,
# turned three settings from words into numbers, and dropped menu rows whose
# commands no longer exist. None of that reaches a machine that upgrades in
# place: the settings file keeps words where numbers are expected and falls
# back to defaults, a user's own presets stop being found, and the menu keeps
# rows calling verbs this version does not answer. The menu is the one part
# it does not look at itself, because menu-block.sh already knows what the
# rows should be and can say whether the file holds them.
migrate() {
  python3 - "$settings" "$HOME/.config/ragtop" <<'PYEOF'
import json, os, sys

settings_path, config_dir = sys.argv[1:]
TRANS = {"opaque": 0, "low": 15, "medium": 30, "high": 50, "full": 100, "auto": 0}
SIZE = {"compact": 88, "normal": 100, "large": 115}
did = []

# Words that are numbers now, and keys that were renamed or retired.
if os.path.exists(settings_path):
    out, changed = [], False
    for line in open(settings_path).read().split("\n"):
        if "=" not in line:
            if line:
                out.append(line)
            continue
        key, value = line.split("=", 1)
        if key in ("transparency", "key-transparency") and value in TRANS:
            value, changed = str(TRANS[value]), True
        elif key == "size" and value in SIZE:
            value, changed = str(SIZE[value]), True
        elif key == "preset":
            key, changed = "theme", True
        elif key == "modifiers":
            changed = True
            continue
        out.append("%s=%s" % (key, value))
    if changed:
        open(settings_path + ".tmp", "w").write("\n".join(out) + "\n")
        os.replace(settings_path + ".tmp", settings_path)
        did.append("settings")

# A preset of their own becomes a theme of their own. The original is left
# where it is, so this cannot lose anyone's work, and an existing theme of
# the same name is never overwritten.
presets = os.path.join(config_dir, "presets")
if os.path.isdir(presets):
    for name in sorted(os.listdir(presets)):
        if not name.endswith(".json"):
            continue
        slug = name[:-5]
        target_dir = os.path.join(config_dir, "themes", slug)
        target = os.path.join(target_dir, "ragtop.toml")
        if os.path.exists(target):
            continue
        try:
            raw = json.load(open(os.path.join(presets, name)))
        except Exception:
            continue
        if not isinstance(raw, dict):
            continue
        rows = []
        for key, value in raw.items():
            if key in ("transparency", "key-transparency") and value in TRANS:
                value = TRANS[value]
            elif key == "size" and value in SIZE:
                value = SIZE[value]
            if isinstance(value, bool):
                rows.append("%s = %s" % (key, "true" if value else "false"))
            elif isinstance(value, (int, float)):
                rows.append("%s = %s" % (key, value))
            elif isinstance(value, str):
                rows.append('%s = "%s"' % (key, value.replace('"', '\\"')))
        if not rows:
            continue
        os.makedirs(target_dir, exist_ok=True)
        open(target, "w").write("\n".join(rows) + "\n")
        did.append("theme:" + slug)

print(" ".join(did))
PYEOF
}

# Themes: the user's own in ~/.config/ragtop/themes/ win over Ragtop's, the
# same two places Omarchy looks for its own themes.
theme_file() {
  [[ $1 =~ ^[a-z0-9-]{1,32}$ ]] || return 1
  local f
  for f in "$HOME/.config/ragtop/themes/$1/ragtop.toml" "$repo/themes/$1/ragtop.toml"; do
    [[ -f $f ]] && { echo "$f"; return 0; }
  done
  return 1
}

# Omarchy's own look first, then the rest by name.
themes() {
  local d
  for d in "$HOME/.config/ragtop/themes/"*/ "$repo/themes/"*/; do
    [[ -f "$d/ragtop.toml" ]] && basename "$d"
  done | sort -u | sed '/^omarchy$/d' | sed '1i omarchy'
}

# apply_theme <name>: write the theme's settings into settings.conf, so what
# the menu shows is what the keyboard does.
apply_theme() {
  local file name
  file=$(theme_file "$1") || { echo "No theme named '$1'. Available: $(themes | tr '\n' ' ')" >&2; exit 2; }
  name=$(python3 - "$file" "$settings" <<'EOF'
import os, re, sys, tomllib

path, settings = sys.argv[1:]
# Only these keys, only these values: a theme can't smuggle anything else in.
choices = {
    "shape": ["omarchy", "rounded", "pill", "angular"],
    "relief": ["flat", "raised"],
    "fill": ["auto", "dark", "light", "outline"],

    "background": ["tint", "gradient"],

    "edge": ["border", "fade", "none"],
    "labels": ["small", "normal", "large"],
    "special-keys": ["off", "darker", "lighter"],
    "blur": ["on", "off"],
}
numbers = {"depth": (0, 10), "chamfer": (0, 20), "edge-fade": (0, 24),
           "key-fill-alpha": (0, 1), "border-width": (0, 4), "radius": (0, 30),
           # 0 is solid and 100 is gone. Size is a percentage of the usual.
           "transparency": (0, 100), "key-transparency": (0, 100), "size": (60, 160)}
colors = ("key-color", "label-color")

try:
    raw = tomllib.load(open(path, "rb"))
except Exception:
    sys.exit("theme isn't valid TOML")

values = {}
for key, allowed in choices.items():
    v = raw.get(key)
    if isinstance(v, bool) and key == "blur":
        v = "on" if v else "off"
    if isinstance(v, str) and v in allowed:
        values[key] = v
for key, (low, high) in numbers.items():
    v = raw.get(key)
    if isinstance(v, (int, float)) and low <= v <= high:
        values[key] = str(round(v, 3))
for key in colors:
    v = raw.get(key)
    if isinstance(v, str) and (v in ("foreground", "background", "accent", "urgent")
                               or re.fullmatch(r"#[0-9a-fA-F]{6,8}", v)):
        values[key] = v

# A theme is a whole look, not a patch: every setting it doesn't name goes
# back to its default rather than keeping whatever the last theme left
# behind. Settings that aren't part of the look, tablet mode and auto-show,
# are untouched.
look_keys = set(choices) | set(numbers) | set(colors)
lines = []
if os.path.exists(settings):
    lines = [l for l in open(settings).read().split("\n")
             if l and l.split("=", 1)[0] not in look_keys]
lines += [f"{k}={v}" for k, v in sorted(values.items())]
os.makedirs(os.path.dirname(settings), exist_ok=True)
open(settings + ".tmp", "w").write("\n".join(lines) + "\n")
os.replace(settings + ".tmp", settings)

label = raw.get("name")
print(label if isinstance(label, str) and label.strip()
      else os.path.basename(os.path.dirname(path)))
EOF
  ) || exit 2
  put theme "$1"
  notify "The keyboard now looks like $name."
}

# What the issue forms ask for by hand, gathered in one place.
#
# This is meant to be pasted into a public issue, so it carries no paths
# under your home directory, no host name and no user name. What it carries
# is the machine, the versions, what Ragtop was told to do, and what it
# found when it looked.

# One string field out of the manifest, which is flat enough to read this way.
manifest_field() {
  sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$repo/manifest.json" | head -n 1
}

row() { printf '%-13s %s\n' "$1" "$2"; }

dmi() { cat "/sys/class/dmi/id/$1" 2>/dev/null || true; }

# Where the running code came from decides what a report means. A linked
# working copy can hold edits that are in no commit, and a directory copied
# in by hand never takes an update.
plugin_source() {
  local dir commit="" state
  dir="$HOME/.config/omarchy/plugins/$(manifest_field id)"
  if commit=$(git -C "$repo" rev-parse --short HEAD 2>/dev/null); then
    git -C "$repo" diff --quiet 2>/dev/null || commit="$commit plus local edits"
    commit="git $commit, "
  fi
  if [[ -L $dir ]]; then state="linked working copy"
  elif [[ -d $dir/.git ]]; then state="installed clone"
  elif [[ -d $dir ]]; then state="copied in by hand"
  else state="not in the plugins directory"
  fi
  echo "$commit$state"
}

diagnostics() {
  local value chassis name version model mode switch layout keymap layers missing=()

  row Ragtop "$(manifest_field version) ($(plugin_source))"
  value=$(omarchy version 2>/dev/null | head -n 1 || true)
  row Omarchy "${value:-unknown}"
  value=$(hyprctl version 2>/dev/null | sed -n '1s/^Hyprland \([^ ]*\).*/\1/p' || true)
  row Hyprland "${value:-unknown}"
  value=$(qs --version 2>/dev/null | awk 'NR == 1 { print $2 }' || true)
  row Quickshell "${value:-unknown}"

  # Vendors put the model in whichever of the two fields they feel like, so
  # print both when they differ rather than guessing which one reads better.
  case "$(dmi chassis_type)" in
    8|9|10|14) chassis="laptop" ;;
    11) chassis="handheld" ;;
    30) chassis="tablet" ;;
    31) chassis="convertible" ;;
    32) chassis="detachable" ;;
    *) chassis="chassis type $(dmi chassis_type)" ;;
  esac
  name=$(dmi product_name)
  version=$(dmi product_version)
  model="$name"
  [[ -n $version && $version != "$name" ]] && model="$name ($version)"
  row Machine "$(dmi sys_vendor) $model, $chassis"

  echo
  mode=$(cat "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ragtop-mode" 2>/dev/null || true)
  row "Tablet mode" "$(get tablet-mode auto)${mode:+, now $mode}"
  switch=$("$repo/find-tablet-switch.py" 2>/dev/null || true)
  if [[ -n $switch ]]; then
    row Switch "$(bash "$repo/udev-rule.sh" status 2>/dev/null || echo unknown), ${switch#*$'\t'}"
  else
    row Switch "none found"
  fi
  # Rotation is what the setting says. Whether monitor-sensor is running is
  # the answer to "the screen does not turn", and the two disagree when
  # something has gone wrong.
  value=$(get rotation auto)
  if ! command -v monitor-sensor >/dev/null; then
    row Rotation "$value, no sensor installed"
  elif pgrep -x monitor-sensor >/dev/null; then
    row Rotation "$value, sensor running"
  else
    row Rotation "$value, sensor not running"
  fi
  layout=$(hyprctl devices 2>/dev/null | sed -n 's/.*l "\([^"]*\)".*/\1/p' | head -n 1 || true)
  keymap=$(hyprctl devices 2>/dev/null | sed -n 's/^[[:space:]]*active keymap: //p' | head -n 1 || true)
  row Layout "${layout:-unknown}${keymap:+, now $keymap}"
  layers=$(hyprctl layers 2>/dev/null | sed -n 's/.*namespace: \(ragtop[a-z-]*\).*/\1/p' | sort -u | tr '\n' ' ' || true)
  row "Surfaces up" "${layers:-none}"

  command -v monitor-sensor >/dev/null || missing+=(iio-sensor-proxy)
  python3 -c "import pywayland" 2>/dev/null || missing+=(python-pywayland)
  python3 -c "import gi" 2>/dev/null || missing+=(python-gobject)
  command -v git >/dev/null || missing+=(git)
  if (( ${#missing[@]} )); then
    row Packages "missing ${missing[*]}"
  else
    row Packages "all present"
  fi
  if [[ -f $conf ]]; then
    row Installer "has run"
  else
    row Installer "has not run"
  fi
  if grep -qsF "// Ragtop: tablet settings." "$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"; then
    row "Menu rows" "present"
  else
    row "Menu rows" "missing"
  fi

  echo
  echo "Overlays"
  "$clones" status 2>/dev/null | sed 's/^/  /' || echo "  unknown"

  echo
  echo "Settings"
  if [[ -f $settings ]]; then
    sed 's/^/  /' "$settings"
  else
    echo "  nothing written yet"
  fi
}

case "${1:-} ${2:-}" in
  "tablet-mode "*) choice tablet-mode auto "${2:-}" "${3:-}" ;;
  "size-adjust "*) choice size-adjust regular "${2:-}" "${3:-}" ;;
  "rotation "*) choice rotation auto "${2:-}" "${3:-}" ;;
  "labels "*) choice labels normal "${2:-}" "${3:-}" ;;
  "theme list") themes ;;
  "theme get") get theme omarchy ;;
  "theme is") [[ -n ${3:-} ]] || usage; [[ $(get theme omarchy) == "$3" ]] ;;
  "theme apply") [[ -n ${3:-} ]] || usage; apply_theme "$3" ;;
  "auto-show "*) switch "$1" "${2:-}" ;;
  "overlay enabled") [[ -n ${3:-} ]] || usage; label "$3" >/dev/null; "$clones" installed "$3" ;;
  "overlay enable") [[ -n ${3:-} ]] || usage; set_overlay "$3" 1 ;;
  "overlay disable") [[ -n ${3:-} ]] || usage; set_overlay "$3" 0 ;;
  "overlay toggle")
    [[ -n ${3:-} ]] || usage
    if "$clones" installed "$3"; then set_overlay "$3" 0; else set_overlay "$3" 1; fi
    ;;
  "overlay status") "$clones" status ;;
  "overlay sync") shift 2; "$clones" sync "$@" ;;
  "migrate "*|"migrate")
    changed=$(migrate)
    if [[ -n $changed ]]; then
      notify "Ragtop brought your settings up to date for this version."
    fi
    # The rows this version writes, whenever the file holds something else.
    # A row an older Ragtop left behind and a row this one added are the same
    # problem, and one rewrite answers both. A menu that was never added
    # stays that way, since putting it there is the installer's job.
    if grep -qsF "// Ragtop: tablet settings." "$menu_file" && ! "$repo/menu-block.sh" check; then
      "$repo/menu-block.sh" add >/dev/null
      changed="${changed:+$changed }menu"
    fi
    if [[ -n $changed ]]; then
      echo "$changed"
    fi
    ;;
  "setup "*|"setup") omarchy-shell ragtop openSetup >/dev/null ;;
  "diagnostics copy")
    if command -v wl-copy >/dev/null; then
      diagnostics | wl-copy
      notify "Diagnostics copied. Paste them into your report."
    else
      diagnostics
    fi
    ;;
  "diagnostics "|"diagnostics") diagnostics ;;
  *) usage ;;
esac
