#!/bin/bash
# Ragtop's settings, behind its rows in the Omarchy menu (Setup › Tablet).
#
# Usage: ragtop overlay enabled <overlay>   succeeds if touch typing is on
#        ragtop overlay enable <overlay>
#        ragtop overlay disable <overlay>
#        ragtop overlay toggle <overlay>
#        ragtop overlay status
#        ragtop auto-show (enabled | enable | disable | toggle)
#        ragtop tablet-mode (get | is <mode> | set <mode>)
#        ragtop transparency (get | is <level> | set <level>)
#        ragtop modifiers (get | is <mode> | set <mode>)
#        ragtop key-style (get | is <style> | set <style> | list)
#        ragtop background (get | is <background> | set <background>)
# where <overlay> is menu, emojis, clipboard, polkit or lock, <mode> is auto
# (follow the hinge's switch), on or off, <level> is auto (match Omarchy's
# bar), opaque, low, medium, high or full, and the modifiers <mode> is
# oneshot or sticky. <style> names a style file in ~/.config/ragtop/styles/
# or Ragtop's styles/ (rounded, rectangle, pill, outline, keycap, angular),
# and <background> is style (the style's own), tint, blur or gradient.
#
# Touch typing in an overlay means replacing Omarchy's own with a patched
# clone (see overlay-clones.sh), so each one is off until the user turns it on.
# Other settings are key=value lines in settings.conf, which Ragtop's
# service watches, so they apply straight away.
set -euo pipefail

repo="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
conf="$HOME/.local/state/ragtop/install.conf"
clones="$repo/overlay-clones.sh"
settings="$HOME/.config/ragtop/settings.conf"

usage() { sed -n '4,21p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

label() {
  case "$1" in
    menu) echo "the Omarchy menu" ;;
    emojis) echo "the emoji picker" ;;
    clipboard) echo "the clipboard picker" ;;
    polkit) echo "the password prompt" ;;
    lock) echo "the lock screen" ;;
    *) echo "Unknown overlay: $1 (expected: menu, emojis, clipboard, polkit, lock)" >&2; exit 2 ;;
  esac
}

# Records which overlays the user turned on, so setup-check.sh can tell a
# clone that went missing from one that was never wanted.
record() {
  local on=() o
  for o in menu emojis clipboard polkit lock; do
    "$clones" installed "$o" && on+=("$o")
  done
  mkdir -p "$(dirname "$conf")"
  if [[ -f $conf ]] && grep -q '^overlays=' "$conf"; then
    sed -i "s/^overlays=.*/overlays=${on[*]}/" "$conf"
  else
    printf 'overlays=%s\n' "${on[*]}" >>"$conf"
  fi
}

notify() {
  command -v omarchy-notification-send >/dev/null &&
    omarchy-notification-send -g 󰌌 "Ragtop" "$1" || true
}

set_overlay() {
  local overlay="$1" on="$2" name
  name=$(label "$overlay")
  if (( on )); then
    "$clones" install "$overlay" >/dev/null
    record
    if [[ $overlay == lock ]]; then
      notify "The lock screen now has an on-screen keyboard in tablet mode."
    else
      notify "Touch typing is on for ${name}."
    fi
  else
    "$clones" remove "$overlay" >/dev/null
    record
    if [[ $overlay == lock ]]; then
      notify "The lock screen no longer has an on-screen keyboard."
    else
      notify "Touch typing is off for ${name}."
    fi
  fi
  # Omarchy only picks clones up, or drops them, when the shell starts.
  omarchy-restart-shell >/dev/null 2>&1 &
}

# get <key> <default>
get() {
  local value
  value=$(sed -n "s/^$1=//p" "$settings" 2>/dev/null | tail -n 1)
  echo "${value:-$2}"
}

# put <key> <value>, written whole and renamed into place so the service
# never reads a half-written file.
put() {
  mkdir -p "$(dirname "$settings")"
  { grep -v "^$1=" "$settings" 2>/dev/null || true; echo "$1=$2"; } >"$settings.tmp"
  mv -f "$settings.tmp" "$settings"
}

# switch <key> <enabled|enable|disable|toggle> for an on/off setting that
# defaults to on.
switch() {
  local key="$1" value
  case "${2:-}" in
    enabled) [[ $(get "$key" on) == on ]]; return ;;
    enable) value=on ;;
    disable) value=off ;;
    toggle) [[ $(get "$key" on) == on ]] && value=off || value=on ;;
    *) usage ;;
  esac
  put "$key" "$value"
  case "$key $value" in
    "auto-show on") notify "The keyboard now comes up by itself on text fields." ;;
    "auto-show off") notify "The keyboard no longer comes up by itself on text fields." ;;
  esac
}

# choice <key> <default> <get|is|set> [value] for a setting with named values;
# the allowed values are the cases in choice_notice.
choice() {
  local key="$1" default="$2"
  case "${3:-}" in
    get) get "$key" "$default" ;;
    is) [[ -n ${4:-} ]] || usage; [[ $(get "$key" "$default") == "$4" ]] ;;
    set)
      local notice
      notice=$(choice_notice "$key" "${4:-}") || usage
      put "$key" "$4"
      notify "$notice"
      ;;
    *) usage ;;
  esac
}

choice_notice() {
  case "$1 $2" in
    "tablet-mode auto") echo "Tablet mode now follows the hinge." ;;
    "tablet-mode on") echo "Tablet mode is on until you change it back." ;;
    "tablet-mode off") echo "Tablet mode is off until you change it back." ;;
    "transparency auto") echo "The keyboard's background now matches the bar's transparency." ;;
    "transparency opaque") echo "The keyboard's background is solid." ;;
    "transparency low"|"transparency medium"|"transparency high") echo "The keyboard's background is now $2 transparency." ;;
    "transparency full") echo "The keyboard's background is fully transparent." ;;
    "modifiers oneshot") echo "Ctrl, Alt, Super and Shift now apply to the next key; tap twice to lock." ;;
    "modifiers sticky") echo "Ctrl, Alt, Super and Shift now stay on until tapped again." ;;
    "background style") echo "The keyboard's background now follows its key style." ;;
    "background tint") echo "The keyboard's background is a flat tint." ;;
    "background blur")
      if hyprctl getoption decoration:blur:enabled 2>/dev/null | grep -q 'bool: true'; then
        echo "The keyboard's background now blurs what's behind it."
      else
        echo "Blur needs Hyprland's blur turned on (decoration.blur.enabled in your Hyprland config); until then it looks like Tint."
      fi
      ;;
    "background gradient") echo "The keyboard's background is a gradient." ;;
    *) return 1 ;;
  esac
}

# Key styles: the user's own in ~/.config/ragtop/styles/ win over Ragtop's.
style_file() {
  [[ $1 =~ ^[a-z0-9-]{1,32}$ ]] || return 1
  local f
  for f in "$HOME/.config/ragtop/styles/$1.json" "$repo/styles/$1.json"; do
    [[ -f $f ]] && { echo "$f"; return 0; }
  done
  return 1
}

styles() {
  local f
  for f in "$HOME/.config/ragtop/styles/"*.json "$repo/styles/"*.json; do
    [[ -f $f ]] && basename "$f" .json
  done | sort -u
}

# A style's display name, from its file's "name", else the file name.
style_name() {
  python3 -c 'import json, sys
try:
    name = json.load(open(sys.argv[1])).get("name")
except Exception:
    name = None
print(name if isinstance(name, str) and name.strip() else sys.argv[2])' "$(style_file "$1")" "$1"
}

case "${1:-} ${2:-}" in
  "tablet-mode "*) choice tablet-mode auto "${2:-}" "${3:-}" ;;
  "transparency "*) choice transparency auto "${2:-}" "${3:-}" ;;
  "modifiers "*) choice modifiers oneshot "${2:-}" "${3:-}" ;;
  "background "*) choice background style "${2:-}" "${3:-}" ;;
  "key-style list") styles ;;
  "key-style set")
    style_file "${3:-}" >/dev/null || { echo "No key style named '${3:-}'. Available: $(styles | tr '\n' ' ')" >&2; exit 2; }
    put key-style "$3"
    notify "The keyboard's keys are now $(style_name "$3")."
    ;;
  "key-style "*) choice key-style rounded "${2:-}" "${3:-}" ;;
  "auto-show "*) switch "$1" "${2:-}" ;;
  "overlay enabled") [[ -n ${3:-} ]] || usage; label "$3" >/dev/null; "$clones" installed "$3" ;;
  "overlay enable") [[ -n ${3:-} ]] || usage; set_overlay "$3" 1 ;;
  "overlay disable") [[ -n ${3:-} ]] || usage; set_overlay "$3" 0 ;;
  "overlay toggle")
    [[ -n ${3:-} ]] || usage
    if "$clones" installed "$3"; then set_overlay "$3" 0; else set_overlay "$3" 1; fi
    ;;
  "overlay status") "$clones" status ;;
  *) usage ;;
esac
