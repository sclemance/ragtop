#!/bin/bash
# Ragtop's settings, behind its rows in the Omarchy menu (Setup › Tablet).
#
# Usage: ragtop overlay enabled <overlay>   succeeds if touch typing is on
#        ragtop overlay enable <overlay>
#        ragtop overlay disable <overlay>
#        ragtop overlay toggle <overlay>
#        ragtop overlay status
#        ragtop overlay sync              re-clones any that Omarchy or Ragtop moved on from
#        ragtop auto-show (enabled | enable | disable | toggle)
#        ragtop tablet-mode (get | is <mode> | set <mode>)
#        ragtop size-adjust (get | is <adjust> | set <adjust>)
#        ragtop theme (list | apply <theme>)
#        ragtop setup                       open setup in the shell
# where <overlay> is menu, emojis, clipboard, polkit, image-picker or lock,
# <mode> is auto
# (follow the hardware switch — folding a hinge or taking the keyboard off),
# on or off.
#
# What a key looks like is a Ragtop theme's to say, so shape, relief, fill,
# background, edge and both transparencies have no verb here and no menu
# row. Whether the keyboard has a background at all follows Omarchy's bar,
# which a double tap on it toggles. What is left is <adjust>, smaller,
# regular or larger, which sizes the keys against whatever the theme asked
# for and is never written by applying one.
#
# A theme is a TOML file of those same settings, laid out the way Omarchy
# lays its own themes out: themes/<slug>/ragtop.toml under Ragtop, and
# ~/.config/ragtop/themes/<slug>/ragtop.toml for your own, where yours wins.
# It sets the keyboard's form. Its colours keep coming from the Omarchy theme.
# Applying one writes its values into settings.conf, so afterwards every
# setting shows what is actually in effect and nothing stays hidden in a file.
#
# Touch typing in an overlay means replacing Omarchy's own with a patched
# clone (see overlay-clones.sh), so each one is off until the user turns it on.
# Other settings are key=value lines in settings.conf, which Ragtop's
# service watches, so they apply straight away.
set -euo pipefail

repo="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
conf="$HOME/.local/state/ragtop/install.conf"
clones="$repo/overlay-clones.sh"
settings="$HOME/.config/ragtop/settings.conf"

usage() { sed -n '4,29p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

label() {
  case "$1" in
    menu) echo "the Omarchy menu" ;;
    emojis) echo "the emoji picker" ;;
    clipboard) echo "the clipboard picker" ;;
    polkit) echo "the password prompt" ;;
    image-picker) echo "the theme and background pickers" ;;
    lock) echo "the lock screen" ;;
    *) echo "Unknown overlay: $1 (expected: menu, emojis, clipboard, polkit, image-picker, lock)" >&2; exit 2 ;;
  esac
}

# Records which overlays the user turned on, so setup-check.sh can tell a
# clone that went missing from one that was never wanted.
record() {
  local on=() o
  for o in menu emojis clipboard polkit image-picker lock; do
    "$clones" installed "$o" && on+=("$o")
  done
  mkdir -p "$(dirname "$conf")"
  if [[ -f $conf ]] && grep -q '^overlays=' "$conf"; then
    sed -i "s/^overlays=.*/overlays=${on[*]}/" "$conf"
  else
    printf 'overlays=%s\n' "${on[*]}" >>"$conf"
  fi
}

notify() {
  command -v omarchy-notification-send >/dev/null &&
    omarchy-notification-send -g 󰌌 "Ragtop" "$1" || true
}

set_overlay() {
  local overlay="$1" on="$2" name
  name=$(label "$overlay")
  if (( on )); then
    "$clones" install "$overlay" >/dev/null
    record
    if [[ $overlay == lock ]]; then
      notify "The lock screen now has an on-screen keyboard in tablet mode."
    elif [[ $overlay == image-picker ]]; then
      notify "${name^} now have arrows and a Select button in tablet mode."
    else
      notify "Touch typing is on for ${name}."
    fi
  else
    "$clones" remove "$overlay" >/dev/null
    record
    if [[ $overlay == lock ]]; then
      notify "The lock screen no longer has an on-screen keyboard."
    elif [[ $overlay == image-picker ]]; then
      notify "${name^} no longer have arrows and a Select button."
    else
      notify "Touch typing is off for ${name}."
    fi
  fi
  # Omarchy only picks clones up, or drops them, when the shell starts.
  omarchy-restart-shell >/dev/null 2>&1 &
}

# get <key> <default>
get() {
  local value
  value=$(sed -n "s/^$1=//p" "$settings" 2>/dev/null | tail -n 1)
  echo "${value:-$2}"
}

# put <key> <value>, written whole and renamed into place so the service
# never reads a half-written file.
put() {
  mkdir -p "$(dirname "$settings")"
  { grep -v "^$1=" "$settings" 2>/dev/null || true; echo "$1=$2"; } >"$settings.tmp"
  mv -f "$settings.tmp" "$settings"
}

# switch <key> <enabled|enable|disable|toggle> for an on/off setting that
# defaults to on.
switch() {
  local key="$1" value
  case "${2:-}" in
    enabled) [[ $(get "$key" on) == on ]]; return ;;
    enable) value=on ;;
    disable) value=off ;;
    toggle) [[ $(get "$key" on) == on ]] && value=off || value=on ;;
    *) usage ;;
  esac
  put "$key" "$value"
  case "$key $value" in
    "auto-show on") notify "The keyboard now comes up by itself on text fields." ;;
    "auto-show off") notify "The keyboard no longer comes up by itself on text fields." ;;
  esac
}

# choice <key> <default> <get|is|set> [value] for a setting with named values;
# the allowed values are the cases in choice_notice.
choice() {
  local key="$1" default="$2"
  case "${3:-}" in
    get) get "$key" "$default" ;;
    is) [[ -n ${4:-} ]] || usage; [[ $(get "$key" "$default") == "$4" ]] ;;
    set)
      local notice
      notice=$(choice_notice "$key" "${4:-}") || usage
      put "$key" "$4"
      notify "$notice"
      ;;
    *) usage ;;
  esac
}

choice_notice() {
  case "$1 $2" in
    "tablet-mode auto") echo "Tablet mode now follows the hardware: fold the screen back, or take the keyboard off." ;;
    "tablet-mode on") echo "Tablet mode is on until you change it back." ;;
    "tablet-mode off") echo "Tablet mode is off until you change it back." ;;
    "size-adjust smaller") echo "The keys are smaller than this theme asks for." ;;
    "size-adjust regular") echo "The keys are the size this theme asks for." ;;
    "size-adjust larger") echo "The keys are larger than this theme asks for." ;;
    "labels small"|"labels normal"|"labels large") echo "The key labels are now $2." ;;
    *) return 1 ;;
  esac
}

# Themes: the user's own in ~/.config/ragtop/themes/ win over Ragtop's, the
# same two places Omarchy looks for its own themes.
theme_file() {
  [[ $1 =~ ^[a-z0-9-]{1,32}$ ]] || return 1
  local f
  for f in "$HOME/.config/ragtop/themes/$1/ragtop.toml" "$repo/themes/$1/ragtop.toml"; do
    [[ -f $f ]] && { echo "$f"; return 0; }
  done
  return 1
}

# Omarchy's own look first, then the rest by name.
themes() {
  local d
  for d in "$HOME/.config/ragtop/themes/"*/ "$repo/themes/"*/; do
    [[ -f "$d/ragtop.toml" ]] && basename "$d"
  done | sort -u | sed '/^omarchy$/d' | sed '1i omarchy'
}

# apply_theme <name>: write the theme's settings into settings.conf, so what
# the menu shows is what the keyboard does.
apply_theme() {
  local file name
  file=$(theme_file "$1") || { echo "No theme named '$1'. Available: $(themes | tr '\n' ' ')" >&2; exit 2; }
  name=$(python3 - "$file" "$settings" <<'EOF'
import os, re, sys, tomllib

path, settings = sys.argv[1:]
# Only these keys, only these values: a theme can't smuggle anything else in.
choices = {
    "shape": ["omarchy", "rounded", "pill", "angular"],
    "relief": ["flat", "raised"],
    "fill": ["auto", "dark", "light", "outline"],

    "background": ["tint", "gradient"],

    "edge": ["border", "fade", "none"],
    "labels": ["small", "normal", "large"],
    "special-keys": ["off", "darker", "lighter"],
    "blur": ["on", "off"],
}
numbers = {"depth": (0, 10), "chamfer": (0, 20), "edge-fade": (0, 24),
           "key-fill-alpha": (0, 1), "border-width": (0, 4), "radius": (0, 30),
           # 0 is solid and 100 is gone. Size is a percentage of the usual.
           "transparency": (0, 100), "key-transparency": (0, 100), "size": (60, 160)}
colors = ("key-color", "label-color")

try:
    raw = tomllib.load(open(path, "rb"))
except Exception:
    sys.exit("theme isn't valid TOML")

values = {}
for key, allowed in choices.items():
    v = raw.get(key)
    if isinstance(v, bool) and key == "blur":
        v = "on" if v else "off"
    if isinstance(v, str) and v in allowed:
        values[key] = v
for key, (low, high) in numbers.items():
    v = raw.get(key)
    if isinstance(v, (int, float)) and low <= v <= high:
        values[key] = str(round(v, 3))
for key in colors:
    v = raw.get(key)
    if isinstance(v, str) and (v in ("foreground", "background", "accent", "urgent")
                               or re.fullmatch(r"#[0-9a-fA-F]{6,8}", v)):
        values[key] = v

# A theme is a whole look, not a patch: every setting it doesn't name goes
# back to its default rather than keeping whatever the last theme left
# behind. Settings that aren't part of the look, tablet mode and auto-show,
# are untouched.
look_keys = set(choices) | set(numbers) | set(colors)
lines = []
if os.path.exists(settings):
    lines = [l for l in open(settings).read().split("\n")
             if l and l.split("=", 1)[0] not in look_keys]
lines += [f"{k}={v}" for k, v in sorted(values.items())]
os.makedirs(os.path.dirname(settings), exist_ok=True)
open(settings + ".tmp", "w").write("\n".join(lines) + "\n")
os.replace(settings + ".tmp", settings)

label = raw.get("name")
print(label if isinstance(label, str) and label.strip() else os.path.basename(path)[:-5])
EOF
  ) || exit 2
  put theme "$1"
  notify "The keyboard now looks like $name."
}

case "${1:-} ${2:-}" in
  "tablet-mode "*) choice tablet-mode auto "${2:-}" "${3:-}" ;;
  "size-adjust "*) choice size-adjust regular "${2:-}" "${3:-}" ;;
  "labels "*) choice labels normal "${2:-}" "${3:-}" ;;
  "theme list") themes ;;
  "theme get") get theme omarchy ;;
  "theme is") [[ -n ${3:-} ]] || usage; [[ $(get theme omarchy) == "$3" ]] ;;
  "theme apply") [[ -n ${3:-} ]] || usage; apply_theme "$3" ;;
  "auto-show "*) switch "$1" "${2:-}" ;;
  "overlay enabled") [[ -n ${3:-} ]] || usage; label "$3" >/dev/null; "$clones" installed "$3" ;;
  "overlay enable") [[ -n ${3:-} ]] || usage; set_overlay "$3" 1 ;;
  "overlay disable") [[ -n ${3:-} ]] || usage; set_overlay "$3" 0 ;;
  "overlay toggle")
    [[ -n ${3:-} ]] || usage
    if "$clones" installed "$3"; then set_overlay "$3" 0; else set_overlay "$3" 1; fi
    ;;
  "overlay status") "$clones" status ;;
  "overlay sync") shift 2; "$clones" sync "$@" ;;
  "setup "*|"setup") omarchy-shell ragtop openSetup >/dev/null ;;
  *) usage ;;
esac
