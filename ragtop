#!/bin/bash
# Ragtop's settings, behind its rows in the Omarchy menu (Setup › Tablet).
#
# Usage: ragtop overlay enabled <overlay>   succeeds if touch typing is on
#        ragtop overlay enable <overlay>
#        ragtop overlay disable <overlay>
#        ragtop overlay toggle <overlay>
#        ragtop overlay status
#        ragtop auto-show (enabled | enable | disable | toggle)
#        ragtop tablet-mode (get | is <mode> | set <mode>)
#        ragtop modifiers (get | is <mode> | set <mode>)
#        ragtop shape (get | is <shape> | set <shape>)
#        ragtop relief (get | is <relief> | set <relief>)
#        ragtop fill (get | is <fill> | set <fill>)
#        ragtop size (get | is <size> | set <size>)
#        ragtop background (get | is <background> | set <background>)
#        ragtop transparency (get | is <level> | set <level>)
#        ragtop key-transparency (get | is <level> | set <level>)
#        ragtop edge (get | is <edge> | set <edge>)
#        ragtop preset (list | apply <preset>)
# where <overlay> is menu, emojis, clipboard, polkit, image-picker or lock,
# <mode> is auto
# (follow the hinge's switch), on or off, and the modifiers <mode> is oneshot
# or sticky.
#
# The keyboard's look: <shape> is omarchy (the theme's own corner rounding),
# rounded, pill or angular; <relief> is flat or raised (keys standing on a
# side, like a keycap); <fill> is dark, light (a key sitting darker or
# lighter than the keyboard) or outline;
# <size> is compact, normal or large; <background> is tint or gradient;
# <level> is auto (match Omarchy's bar), opaque, low, medium, high or full
# for the background, and the same without auto for the keys;
# <edge> is border (the theme's window border), fade or none.
#
# A preset is a JSON file of those same settings, in ~/.config/ragtop/presets/
# or Ragtop's presets/. Applying one writes its values into settings.conf, so
# afterwards every setting shows what's actually in effect; nothing stays
# hidden in the file.
#
# Touch typing in an overlay means replacing Omarchy's own with a patched
# clone (see overlay-clones.sh), so each one is off until the user turns it on.
# Other settings are key=value lines in settings.conf, which Ragtop's
# service watches, so they apply straight away.
set -euo pipefail

repo="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
conf="$HOME/.local/state/ragtop/install.conf"
clones="$repo/overlay-clones.sh"
settings="$HOME/.config/ragtop/settings.conf"

usage() { sed -n '4,29p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

label() {
  case "$1" in
    menu) echo "the Omarchy menu" ;;
    emojis) echo "the emoji picker" ;;
    clipboard) echo "the clipboard picker" ;;
    polkit) echo "the password prompt" ;;
    image-picker) echo "the theme and background pickers" ;;
    lock) echo "the lock screen" ;;
    *) echo "Unknown overlay: $1 (expected: menu, emojis, clipboard, polkit, image-picker, lock)" >&2; exit 2 ;;
  esac
}

# Records which overlays the user turned on, so setup-check.sh can tell a
# clone that went missing from one that was never wanted.
record() {
  local on=() o
  for o in menu emojis clipboard polkit image-picker lock; do
    "$clones" installed "$o" && on+=("$o")
  done
  mkdir -p "$(dirname "$conf")"
  if [[ -f $conf ]] && grep -q '^overlays=' "$conf"; then
    sed -i "s/^overlays=.*/overlays=${on[*]}/" "$conf"
  else
    printf 'overlays=%s\n' "${on[*]}" >>"$conf"
  fi
}

notify() {
  command -v omarchy-notification-send >/dev/null &&
    omarchy-notification-send -g 󰌌 "Ragtop" "$1" || true
}

set_overlay() {
  local overlay="$1" on="$2" name
  name=$(label "$overlay")
  if (( on )); then
    "$clones" install "$overlay" >/dev/null
    record
    if [[ $overlay == lock ]]; then
      notify "The lock screen now has an on-screen keyboard in tablet mode."
    elif [[ $overlay == image-picker ]]; then
      notify "${name^} now have arrows and a Select button in tablet mode."
    else
      notify "Touch typing is on for ${name}."
    fi
  else
    "$clones" remove "$overlay" >/dev/null
    record
    if [[ $overlay == lock ]]; then
      notify "The lock screen no longer has an on-screen keyboard."
    elif [[ $overlay == image-picker ]]; then
      notify "${name^} no longer have arrows and a Select button."
    else
      notify "Touch typing is off for ${name}."
    fi
  fi
  # Omarchy only picks clones up, or drops them, when the shell starts.
  omarchy-restart-shell >/dev/null 2>&1 &
}

# get <key> <default>
get() {
  local value
  value=$(sed -n "s/^$1=//p" "$settings" 2>/dev/null | tail -n 1)
  echo "${value:-$2}"
}

# put <key> <value>, written whole and renamed into place so the service
# never reads a half-written file.
put() {
  mkdir -p "$(dirname "$settings")"
  { grep -v "^$1=" "$settings" 2>/dev/null || true; echo "$1=$2"; } >"$settings.tmp"
  mv -f "$settings.tmp" "$settings"
}

# switch <key> <enabled|enable|disable|toggle> for an on/off setting that
# defaults to on.
switch() {
  local key="$1" value
  case "${2:-}" in
    enabled) [[ $(get "$key" on) == on ]]; return ;;
    enable) value=on ;;
    disable) value=off ;;
    toggle) [[ $(get "$key" on) == on ]] && value=off || value=on ;;
    *) usage ;;
  esac
  put "$key" "$value"
  case "$key $value" in
    "auto-show on") notify "The keyboard now comes up by itself on text fields." ;;
    "auto-show off") notify "The keyboard no longer comes up by itself on text fields." ;;
  esac
}

# choice <key> <default> <get|is|set> [value] for a setting with named values;
# the allowed values are the cases in choice_notice.
choice() {
  local key="$1" default="$2"
  case "${3:-}" in
    get) get "$key" "$default" ;;
    is) [[ -n ${4:-} ]] || usage; [[ $(get "$key" "$default") == "$4" ]] ;;
    set)
      local notice
      notice=$(choice_notice "$key" "${4:-}") || usage
      put "$key" "$4"
      notify "$notice"
      ;;
    *) usage ;;
  esac
}

choice_notice() {
  case "$1 $2" in
    "tablet-mode auto") echo "Tablet mode now follows the hinge." ;;
    "tablet-mode on") echo "Tablet mode is on until you change it back." ;;
    "tablet-mode off") echo "Tablet mode is off until you change it back." ;;
    "transparency auto") echo "The keyboard's background now matches the bar's transparency." ;;
    "transparency opaque") echo "The keyboard's background is solid." ;;
    "transparency low"|"transparency medium"|"transparency high") echo "The keyboard's background is now $2 transparency." ;;
    "transparency full") echo "The keyboard's background is fully transparent." ;;
    "key-transparency opaque") echo "The keys are solid." ;;
    "key-transparency low"|"key-transparency medium"|"key-transparency high") echo "The keys are now $2 transparency." ;;
    "key-transparency full") echo "The keys are fully transparent." ;;
    "modifiers oneshot") echo "Ctrl, Alt, Super and Shift now apply to the next key; tap twice to lock." ;;
    "modifiers sticky") echo "Ctrl, Alt, Super and Shift now stay on until tapped again." ;;
    "background tint") echo "The keyboard's background is a flat tint." ;;
    "background gradient") echo "The keyboard's background is a gradient." ;;
    "edge border") echo "The keyboard's top edge now has the same border as your tiled windows." ;;
    "edge fade") echo "The keyboard's background now fades out at its top edge." ;;
    "edge none") echo "The keyboard's top edge is now a hard edge." ;;
    "shape omarchy") echo "The keys now follow your theme's corner rounding." ;;
    "shape rounded"|"shape pill"|"shape angular") echo "The keys are now $2." ;;
    "relief flat") echo "The keys are flat." ;;
    "relief raised") echo "The keys now stand on a side, like a keycap." ;;
    "fill dark") echo "The keys now sit darker than the keyboard." ;;
    "fill light") echo "The keys now sit lighter than the keyboard." ;;
    "fill outline") echo "The keys have no fill, drawn as outlines." ;;
    "size compact") echo "The keys are now compact." ;;
    "size normal") echo "The keys are back to their normal size." ;;
    "size large") echo "The keys are now large." ;;
    "labels small"|"labels normal"|"labels large") echo "The key labels are now $2." ;;
    *) return 1 ;;
  esac
}

# Presets: the user's own in ~/.config/ragtop/presets/ win over Ragtop's.
preset_file() {
  [[ $1 =~ ^[a-z0-9-]{1,32}$ ]] || return 1
  local f
  for f in "$HOME/.config/ragtop/presets/$1.json" "$repo/presets/$1.json"; do
    [[ -f $f ]] && { echo "$f"; return 0; }
  done
  return 1
}

# Omarchy's own look first, then the rest by name.
presets() {
  local f
  for f in "$HOME/.config/ragtop/presets/"*.json "$repo/presets/"*.json; do
    [[ -f $f ]] && basename "$f" .json
  done | sort -u | sed '/^omarchy$/d' | sed '1i omarchy'
}

# apply_preset <name>: write the preset's settings into settings.conf, so
# what the menu shows is what the keyboard does.
apply_preset() {
  local file name
  file=$(preset_file "$1") || { echo "No preset named '$1'. Available: $(presets | tr '\n' ' ')" >&2; exit 2; }
  name=$(python3 - "$file" "$settings" <<'EOF'
import json, os, re, sys

path, settings = sys.argv[1:]
# Only these keys, only these values: a preset can't smuggle anything else in.
choices = {
    "shape": ["omarchy", "rounded", "pill", "angular"],
    "relief": ["flat", "raised"],
    "fill": ["dark", "light", "outline"],
    "size": ["compact", "normal", "large"],
    "background": ["tint", "gradient"],
    "transparency": ["auto", "opaque", "low", "medium", "high", "full"],
    "key-transparency": ["opaque", "low", "medium", "high", "full"],
    "edge": ["border", "fade", "none"],
    "labels": ["small", "normal", "large"],
    "blur": ["on", "off"],
}
numbers = {"depth": (0, 10), "chamfer": (0, 20), "edge-fade": (0, 24),
           "key-fill-alpha": (0, 1), "border-width": (0, 4), "radius": (0, 30)}
colors = ("key-color", "label-color")

try:
    raw = json.load(open(path))
except Exception:
    sys.exit("preset isn't valid JSON")
if not isinstance(raw, dict):
    sys.exit("preset isn't a JSON object")

values = {}
for key, allowed in choices.items():
    v = raw.get(key)
    if isinstance(v, bool) and key == "blur":
        v = "on" if v else "off"
    if isinstance(v, str) and v in allowed:
        values[key] = v
for key, (low, high) in numbers.items():
    v = raw.get(key)
    if isinstance(v, (int, float)) and low <= v <= high:
        values[key] = str(round(v, 3))
for key in colors:
    v = raw.get(key)
    if isinstance(v, str) and (v in ("foreground", "background", "accent", "urgent")
                               or re.fullmatch(r"#[0-9a-fA-F]{6,8}", v)):
        values[key] = v

lines = []
if os.path.exists(settings):
    lines = [l for l in open(settings).read().split("\n") if l and l.split("=", 1)[0] not in values]
lines += [f"{k}={v}" for k, v in sorted(values.items())]
os.makedirs(os.path.dirname(settings), exist_ok=True)
open(settings + ".tmp", "w").write("\n".join(lines) + "\n")
os.replace(settings + ".tmp", settings)

label = raw.get("name")
print(label if isinstance(label, str) and label.strip() else os.path.basename(path)[:-5])
EOF
  ) || exit 2
  put preset "$1"
  notify "The keyboard now looks like $name."
}

case "${1:-} ${2:-}" in
  "tablet-mode "*) choice tablet-mode auto "${2:-}" "${3:-}" ;;
  "transparency "*) choice transparency auto "${2:-}" "${3:-}" ;;
  "key-transparency "*) choice key-transparency opaque "${2:-}" "${3:-}" ;;
  "modifiers "*) choice modifiers oneshot "${2:-}" "${3:-}" ;;
  "background "*) choice background tint "${2:-}" "${3:-}" ;;
  "edge "*) choice edge none "${2:-}" "${3:-}" ;;
  "shape "*) choice shape omarchy "${2:-}" "${3:-}" ;;
  "relief "*) choice relief flat "${2:-}" "${3:-}" ;;
  "fill "*) choice fill light "${2:-}" "${3:-}" ;;
  "size "*) choice size normal "${2:-}" "${3:-}" ;;
  "labels "*) choice labels normal "${2:-}" "${3:-}" ;;
  "preset list") presets ;;
  "preset get") get preset omarchy ;;
  "preset is") [[ -n ${3:-} ]] || usage; [[ $(get preset omarchy) == "$3" ]] ;;
  "preset apply") [[ -n ${3:-} ]] || usage; apply_preset "$3" ;;
  "auto-show "*) switch "$1" "${2:-}" ;;
  "overlay enabled") [[ -n ${3:-} ]] || usage; label "$3" >/dev/null; "$clones" installed "$3" ;;
  "overlay enable") [[ -n ${3:-} ]] || usage; set_overlay "$3" 1 ;;
  "overlay disable") [[ -n ${3:-} ]] || usage; set_overlay "$3" 0 ;;
  "overlay toggle")
    [[ -n ${3:-} ]] || usage
    if "$clones" installed "$3"; then set_overlay "$3" 0; else set_overlay "$3" 1; fi
    ;;
  "overlay status") "$clones" status ;;
  *) usage ;;
esac
